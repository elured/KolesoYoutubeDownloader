<UserControl x:Class="KolesoYoutubeDownloader.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KolesoYoutubeDownloader.Views"
             xmlns:vm="clr-namespace:KolesoYoutubeDownloader.ViewModels"
             xmlns:conv="clr-namespace:KolesoYoutubeDownloader.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Koleso YouTube Downloader" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20" 
                   Foreground="#333333" 
                   HorizontalAlignment="Center"/>

        <!-- URL Видео -->
        <StackPanel Grid.Row="1" 
                    Margin="0,0,0,15">
            <TextBlock Text="URL видео:" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,5" 
                       Foreground="#555555"/>
            <TextBox Text="{Binding VideoUrl, UpdateSourceTrigger=PropertyChanged}" 
                     IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBooleanConverter}}" 
                     Padding="5" 
                     FontSize="14"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" 
                    Margin="0,45,0,10"
                    Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}">

            <ProgressBar IsIndeterminate="True" 
                         Width="100" 
                         Height="12" 
                         Margin="0,0,10,0"/>

            <TextBlock Text="Анализируем доступные форматы видео..." 
                       Foreground="#007ACC" 
                       FontStyle="Italic" 
                       VerticalAlignment="Center"/>
        </StackPanel>
        <!-- Формат и Обрезка -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Формат -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Формат скачивания:" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,5" 
                           Foreground="#555555"/>
                <RadioButton Content="Только аудио (FLAC/MP3)" 
                             IsChecked="{Binding IsAudioOnly, UpdateSourceTrigger=PropertyChanged}" 
                             GroupName="FormatGroup" 
                             Margin="0,2,0,2" 
                             IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBooleanConverter}}"/>

                <RadioButton Content="Видео (MP4)" 
                             IsChecked="{Binding IsAudioOnly, Converter={StaticResource InverseBooleanConverter}, UpdateSourceTrigger=PropertyChanged}" 
                             GroupName="FormatGroup" 
                             Margin="0,2,0,2" 
                             IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBooleanConverter}}"/>
            </StackPanel>
            <!-- Обрезка -->
            <StackPanel Grid.Column="1" 
                        Margin="10,0,0,0">
                <TextBlock Text="Обрезка (опционально):" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,5" 
                           Foreground="#555555"/>

                <!-- Блок Начало -->
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                           Text="Начало:" 
                           VerticalAlignment="Center"/>

                    <!-- Часы -->
                    <TextBox Grid.Column="1" 
                         Text="{Binding StartTime.Hours, UpdateSourceTrigger=PropertyChanged}" 
                         IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBooleanConverter}}" 
                         Width="30" 
                         MaxLength="2" 
                         TextAlignment="Center" 
                         Padding="2"/>

                    <TextBlock Grid.Column="2" 
                           Text=":" 
                           VerticalAlignment="Center" 
                           Margin="3,0"/>

                    <!-- Минуты -->
                    <TextBox Grid.Column="3" 
                         Text="{Binding StartTime.Minutes, UpdateSourceTrigger=PropertyChanged}" 
                         IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBooleanConverter}}" 
                         Width="30" 
                         MaxLength="2" 
                         TextAlignment="Center" 
                         Padding="2"/>

                    <TextBlock Grid.Column="4" 
                           Text=":" 
                           VerticalAlignment="Center" 
                           Margin="3,0"/>

                    <!-- Секунды -->
                    <TextBox Grid.Column="5" 
                         Text="{Binding StartTime.Seconds, UpdateSourceTrigger=PropertyChanged}" 
                         IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBooleanConverter}}" 
                         Width="30" 
                         MaxLength="2" 
                         TextAlignment="Center" 
                         Padding="2"/>

                    <TextBlock Grid.Column="6" 
                           Text="." 
                           VerticalAlignment="Center" 
                           Margin="3,0"/>

                    <!-- Миллисекунды -->
                    <TextBox Grid.Column="7" 
                         Text="{Binding StartTime.Milliseconds, UpdateSourceTrigger=PropertyChanged}" 
                         IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBooleanConverter}}" 
                         Width="40" 
                         MaxLength="3" 
                         TextAlignment="Center" 
                         Padding="2"/>
                </Grid>

                <!-- Блок Конец -->
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                           Text="Конец:" 
                           VerticalAlignment="Center"/>

                    <!-- Часы -->
                    <TextBox Grid.Column="1" 
                         Text="{Binding EndTime.Hours, UpdateSourceTrigger=PropertyChanged}" 
                         IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBooleanConverter}}" 
                         Width="30" 
                         MaxLength="2" 
                         TextAlignment="Center" 
                         Padding="2"/>

                    <TextBlock Grid.Column="2" 
                           Text=":" 
                           VerticalAlignment="Center" 
                           Margin="3,0"/>

                    <!-- Минуты -->
                    <TextBox Grid.Column="3" 
                         Text="{Binding EndTime.Minutes, UpdateSourceTrigger=PropertyChanged}" 
                         IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBooleanConverter}}" 
                         Width="30" 
                         MaxLength="2" 
                         TextAlignment="Center" 
                         Padding="2"/>

                    <TextBlock Grid.Column="4" 
                           Text=":" 
                           VerticalAlignment="Center" 
                           Margin="3,0"/>

                    <!-- Секунды -->
                    <TextBox Grid.Column="5" 
                         Text="{Binding EndTime.Seconds, UpdateSourceTrigger=PropertyChanged}" 
                         IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBooleanConverter}}" 
                         Width="30" 
                         MaxLength="2" 
                         TextAlignment="Center" 
                         Padding="2"/>

                    <TextBlock Grid.Column="6" 
                           Text="." 
                           VerticalAlignment="Center" 
                           Margin="3,0"/>

                    <!-- Миллисекунды -->
                    <TextBox Grid.Column="7" 
                         Text="{Binding EndTime.Milliseconds, UpdateSourceTrigger=PropertyChanged}" 
                         IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBooleanConverter}}" 
                         Width="40" 
                         MaxLength="3" 
                         TextAlignment="Center" 
                         Padding="2"/>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Прогресс и Статус -->
        <StackPanel Grid.Row="4" 
                    Margin="0,0,0,15">
            <Grid Margin="0,0,0,5">
                <TextBlock Text="{Binding StatusText}" 
                           HorizontalAlignment="Left" 
                           Foreground="#666666"/>
                <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:F1}%}" 
                           HorizontalAlignment="Right" 
                           Foreground="#666666"/>
            </Grid>
            <ProgressBar Value="{Binding ProgressPercent}" 
                         Height="15" 
                         Minimum="0" 
                         Maximum="100"/>
        </StackPanel>

        <!-- Кнопка Скачать -->
        <Button Grid.Row="5" 
                Command="{Binding DownloadCommand}" 
                Content="Скачать" 
                Height="40" FontSize="16" 
                FontWeight="Bold" 
                Background="#0078D7" 
                Foreground="White" 
                BorderThickness="0" 
                Cursor="Hand"/>

    </Grid>
</UserControl>
